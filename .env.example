# Variables de entorno opcionales para Alfred

# URL base del sitio (usado en sitemap y robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.alfredtech.online

# Google Analytics 4 - Measurement ID
# Para habilitar GA4, configurar en Vercel con el ID de medición (ej: G-XXXXXXXXXX)
# Si no está configurado, GA4 no se cargará
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console - Verificación (opcional, para implementar más adelante)
# NEXT_PUBLIC_GSC_VERIFICATION=
